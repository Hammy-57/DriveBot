# Copy to ".env" locally, or set these as variables on your host (Railway/Render).
# Leave TWILIO_* empty to run in DEV MODE (messages print to the console).

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# DEMO ONLY (Twilio Sandbox): send plain text instead of templates.
# Leave empty in production.
SANDBOX_FREEFORM=

# Approved WhatsApp templates (Twilio Console -> Messaging -> Content Template Builder).
TWILIO_TEMPLATE_REMINDER_24H=
TWILIO_TEMPLATE_REMINDER_2H=
TWILIO_TEMPLATE_WAITLIST_OFFER=
TWILIO_TEMPLATE_INSTRUCTOR_NOTICE=

# Your deployed URL, e.g. https://drivebot.up.railway.app (no trailing slash).
# When set, Twilio signatures are verified AND the app refuses to start
# with the default admin password.
PUBLIC_BASE_URL=

# Where the database lives. On a host, point this at the persistent volume:
# DATABASE_URL=sqlite:////data/drivebot.db
DATABASE_URL=sqlite:///drivebot.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
